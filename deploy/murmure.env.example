# Copy to /etc/murmure.env (or export the variables) and adapt. Everything is optional.

# Instance directory: servers.json, voices/, plugins/, system_prompt.txt, pronunciation.txt, key files (default: current directory)
#MURMURE_HOME=/opt/murmure

# Listen address. The browser microphone needs HTTPS outside localhost: set MURMURE_CERT and MURMURE_KEY to serve HTTPS directly.
MURMURE_BIND=127.0.0.1
MURMURE_PORT=8080
#MURMURE_CERT=/path/to/cert.crt
#MURMURE_KEY=/path/to/cert.key

# LLM servers: copy servers.example.json to servers.json (or point to it). Without it, a single local server is used.
#MURMURE_SERVERS_FILE=/path/to/servers.json
#MURMURE_LLM_URL=http://127.0.0.1:8080

# Weather (Open-Meteo) and timezone of the forecast
MURMURE_CITY=Paris
MURMURE_LAT=48.8566
MURMURE_LON=2.3522
#MURMURE_TZ=Europe/Paris

# Web search: a SearXNG instance with the JSON format enabled
#MURMURE_SEARX_URL=http://127.0.0.1:8888/search

# Piper voice (.onnx next to its .onnx.json) and speaker number
#MURMURE_VOICE=/path/to/voices/fr_FR-upmc-medium.onnx
#MURMURE_SPEAKER=1

# Timers and reminders: command run when they expire, called as `<command> "<title>" "<message>"` (see deploy/notify-ntfy.sh).
# Without it, timers and reminders are disabled.
#MURMURE_NOTIFY_CMD=/path/to/notify-ntfy.sh

# Alexa skill (optional, needs the "alexa" extra): both must be set. The token is a secret path, e.g. `openssl rand -hex 16`.
#MURMURE_ALEXA_SKILL_ID=amzn1.ask.skill.xxxxxxxx
#MURMURE_ALEXA_TOKEN=
#MURMURE_ALEXA_BIND=127.0.0.1
#MURMURE_ALEXA_PORT=8765

# Plugins: directory of *.py files (default: MURMURE_HOME/plugins). The example backup plugin needs its JSON files:
#MURMURE_PLUGINS=/path/to/plugins
#MURMURE_STATUS_JSON=/path/to/status.json
#MURMURE_CHECK_JSON=/path/to/check.json
